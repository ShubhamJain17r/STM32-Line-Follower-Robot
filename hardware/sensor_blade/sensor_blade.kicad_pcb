(kicad_pcb (version 20240108) (generator "pcbnew")

  (general
    (thickness 1.0)
    (legacy_teardrops no)
  )

  (paper "A4")

  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (32 "B.Adhes" user "B.Adhesive")
    (33 "F.Adhes" user "F.Adhesive")
    (34 "B.Paste" user)
    (35 "F.Paste" user)
    (36 "B.SilkS" user "B.Silkscreen")
    (37 "F.SilkS" user "F.Silkscreen")
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (40 "Dwgs.User" user "User.Drawings")
    (41 "Cmts.User" user "User.Comments")
    (44 "Edge.Cuts" user)
    (46 "B.CrtYd" user "B.Courtyard")
    (47 "F.CrtYd" user "F.Courtyard")
    (48 "B.Fab" user)
    (49 "F.Fab" user)
  )

  (setup
    (pad_to_mask_clearance 0.05)
    (pcbplotparams
      (layerselection 0x00010fc_ffffffff)
      (outputdirectory "gerbers/")
    )
  )

  (net 0 "")
  (net 1 "GND")
  (net 2 "+3.3V")
  (net 3 "EMITTER_K")
  (net 4 "EMITTER_GATE")
  (net 5 "S1_ADC")
  (net 6 "S2_ADC")
  (net 7 "S3_ADC")
  (net 8 "S4_ADC")
  (net 9 "S5_ADC")
  (net 10 "S6_ADC")
  (net 11 "S7_ADC")
  (net 12 "S8_ADC")

  ;; Board Outline (65.0 mm x 16.0 mm, Centered at (0, 0))
  ;; X from -32.5 to +32.5, Y from -8.0 to +8.0
  (gr_line (start -31.0 -8.0) (end 31.0 -8.0) (layer "Edge.Cuts") (width 0.15) (uuid "sb-e1"))
  (gr_arc (start 31.0 -8.0) (mid 32.06 -7.06) (end 32.5 -5.5) (layer "Edge.Cuts") (width 0.15) (uuid "sb-e2"))
  (gr_line (start 32.5 -5.5) (end 32.5 5.5) (layer "Edge.Cuts") (width 0.15) (uuid "sb-e3"))
  (gr_arc (start 32.5 5.5) (mid 32.06 7.06) (end 31.0 8.0) (layer "Edge.Cuts") (width 0.15) (uuid "sb-e4"))
  (gr_line (start 31.0 8.0) (end -31.0 8.0) (layer "Edge.Cuts") (width 0.15) (uuid "sb-e5"))
  (gr_arc (start -31.0 8.0) (mid -32.06 7.06) (end -32.5 5.5) (layer "Edge.Cuts") (width 0.15) (uuid "sb-e6"))
  (gr_line (start -32.5 5.5) (end -32.5 -5.5) (layer "Edge.Cuts") (width 0.15) (uuid "sb-e7"))
  (gr_arc (start -32.5 -5.5) (mid -32.06 -7.06) (end -31.0 -8.0) (layer "Edge.Cuts") (width 0.15) (uuid "sb-e8"))

  ;; 2x Slotted M2.5 / M3 Mounting Holes at (-29.0, 0.0) and (+29.0, 0.0) for height adjustment
  (footprint "MountingHole:MountingHole_3.2mm_M3" (layer "F.Cu")
    (at -29.0 0.0) (uuid "sb-mh1")
    (property "Reference" "H1" (at 0 -2.5) (layer "F.SilkS") (effects (font (size 0.8 0.8))))
    (pad "1" thru_hole oval (at 0 0) (size 3.2 5.0) (drill oval 2.7 4.5) (layers "*.Cu" "*.Mask") (net 1 "GND"))
  )
  (footprint "MountingHole:MountingHole_3.2mm_M3" (layer "F.Cu")
    (at 29.0 0.0) (uuid "sb-mh2")
    (property "Reference" "H2" (at 0 -2.5) (layer "F.SilkS") (effects (font (size 0.8 0.8))))
    (pad "1" thru_hole oval (at 0 0) (size 3.2 5.0) (drill oval 2.7 4.5) (layers "*.Cu" "*.Mask") (net 1 "GND"))
  )

  ;; Silkscreen Markings
  (gr_text "QTR-8 BLADE v2.0" (at 0.0 -6.5) (layer "F.SilkS")
    (effects (font (size 1.0 1.0) (thickness 0.15))) (uuid "txt-sb-title")
  )
  (gr_text "7.5mm PITCH" (at 0.0 6.5) (layer "F.SilkS")
    (effects (font (size 0.8 0.8) (thickness 0.12))) (uuid "txt-sb-pitch")
  )

  ;; 8x Vishay QRE1113GR Reflectance Sensors along Y = 2.0 (facing track)
  ;; Precision 7.5 mm pitch from X = -26.25 to +26.25
  (footprint "OptoDevice:Vishay_QRE1113GR" (layer "F.Cu")
    (at -26.25 2.0) (uuid "fp-s1")
    (property "Reference" "S1" (at 0 -2.5) (layer "F.SilkS") (effects (font (size 0.8 0.8))))
    (property "Value" "QRE1113GR" (at 0 2.5) (layer "F.Fab") (effects (font (size 0.8 0.8))))
    (property "LCSC" "C138766" (at 0 0) (layer "F.Fab") (effects (font (size 1 1)) hide))
  )
  (footprint "OptoDevice:Vishay_QRE1113GR" (layer "F.Cu")
    (at -18.75 2.0) (uuid "fp-s2")
    (property "Reference" "S2" (at 0 -2.5) (layer "F.SilkS") (effects (font (size 0.8 0.8))))
    (property "Value" "QRE1113GR" (at 0 2.5) (layer "F.Fab") (effects (font (size 0.8 0.8))))
    (property "LCSC" "C138766" (at 0 0) (layer "F.Fab") (effects (font (size 1 1)) hide))
  )
  (footprint "OptoDevice:Vishay_QRE1113GR" (layer "F.Cu")
    (at -11.25 2.0) (uuid "fp-s3")
    (property "Reference" "S3" (at 0 -2.5) (layer "F.SilkS") (effects (font (size 0.8 0.8))))
    (property "Value" "QRE1113GR" (at 0 2.5) (layer "F.Fab") (effects (font (size 0.8 0.8))))
    (property "LCSC" "C138766" (at 0 0) (layer "F.Fab") (effects (font (size 1 1)) hide))
  )
  (footprint "OptoDevice:Vishay_QRE1113GR" (layer "F.Cu")
    (at -3.75 2.0) (uuid "fp-s4")
    (property "Reference" "S4" (at 0 -2.5) (layer "F.SilkS") (effects (font (size 0.8 0.8))))
    (property "Value" "QRE1113GR" (at 0 2.5) (layer "F.Fab") (effects (font (size 0.8 0.8))))
    (property "LCSC" "C138766" (at 0 0) (layer "F.Fab") (effects (font (size 1 1)) hide))
  )
  (footprint "OptoDevice:Vishay_QRE1113GR" (layer "F.Cu")
    (at 3.75 2.0) (uuid "fp-s5")
    (property "Reference" "S5" (at 0 -2.5) (layer "F.SilkS") (effects (font (size 0.8 0.8))))
    (property "Value" "QRE1113GR" (at 0 2.5) (layer "F.Fab") (effects (font (size 0.8 0.8))))
    (property "LCSC" "C138766" (at 0 0) (layer "F.Fab") (effects (font (size 1 1)) hide))
  )
  (footprint "OptoDevice:Vishay_QRE1113GR" (layer "F.Cu")
    (at 11.25 2.0) (uuid "fp-s6")
    (property "Reference" "S6" (at 0 -2.5) (layer "F.SilkS") (effects (font (size 0.8 0.8))))
    (property "Value" "QRE1113GR" (at 0 2.5) (layer "F.Fab") (effects (font (size 0.8 0.8))))
    (property "LCSC" "C138766" (at 0 0) (layer "F.Fab") (effects (font (size 1 1)) hide))
  )
  (footprint "OptoDevice:Vishay_QRE1113GR" (layer "F.Cu")
    (at 18.75 2.0) (uuid "fp-s7")
    (property "Reference" "S7" (at 0 -2.5) (layer "F.SilkS") (effects (font (size 0.8 0.8))))
    (property "Value" "QRE1113GR" (at 0 2.5) (layer "F.Fab") (effects (font (size 0.8 0.8))))
    (property "LCSC" "C138766" (at 0 0) (layer "F.Fab") (effects (font (size 1 1)) hide))
  )
  (footprint "OptoDevice:Vishay_QRE1113GR" (layer "F.Cu")
    (at 26.25 2.0) (uuid "fp-s8")
    (property "Reference" "S8" (at 0 -2.5) (layer "F.SilkS") (effects (font (size 0.8 0.8))))
    (property "Value" "QRE1113GR" (at 0 2.5) (layer "F.Fab") (effects (font (size 0.8 0.8))))
    (property "LCSC" "C138766" (at 0 0) (layer "F.Fab") (effects (font (size 1 1)) hide))
  )

  ;; 11-Pin Inter-Board JST-PH 2.0mm Horizontal Connector J7
  (footprint "Connector_JST:JST_PH_S11B-PH-K_1x11_P2.00mm_Horizontal" (layer "F.Cu")
    (at 0.0 -4.0) (uuid "fp-j7")
    (property "Reference" "J7" (at 0 -3.0) (layer "F.SilkS") (effects (font (size 0.8 0.8))))
    (property "Value" "SENSOR_INTERCONNECT_11P" (at 0 3.0) (layer "F.Fab") (effects (font (size 0.8 0.8))))
    (property "LCSC" "C295751" (at 0 0) (layer "F.Fab") (effects (font (size 1 1)) hide))
  )

  ;; Q_GATE: 2N7002 N-Channel MOSFET for AutoDifferential Ambient Rejection
  (footprint "Package_TO_SOT_SMD:SOT-23" (layer "F.Cu")
    (at -18.75 -3.5) (uuid "fp-qgate")
    (property "Reference" "Q_GATE" (at 0 -2.0) (layer "F.SilkS") (effects (font (size 0.8 0.8))))
    (property "Value" "2N7002" (at 0 2.0) (layer "F.Fab") (effects (font (size 0.8 0.8))))
