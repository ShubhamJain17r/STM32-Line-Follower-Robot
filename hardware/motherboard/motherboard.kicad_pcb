  (net 19 "AIN2_PC9")
  (net 20 "PWMB_TIM2_CH2")
  (net 21 "BIN1_PC11")
  (net 22 "BIN2_PC12")
  (net 23 "ENC_L_A_PA6")
  (net 24 "ENC_L_B_PA7")
  (net 25 "ENC_R_A_PB6")
  (net 26 "ENC_R_B_PB7")
