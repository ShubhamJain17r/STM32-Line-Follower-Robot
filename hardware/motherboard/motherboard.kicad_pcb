  (gr_line (start 80.0 3.0) (end 80.0 47.0) (layer "Edge.Cuts") (width 0.15) (uuid "edge-right"))
  (gr_arc (start 80.0 47.0) (mid 79.121 49.121) (end 77.0 50.0) (layer "Edge.Cuts") (width 0.15) (uuid "edge-corner-br"))
